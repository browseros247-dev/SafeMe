# Template for release signing credentials.
# Copy to keystore.properties and fill in the real values (keystore.properties is gitignored).
# Generate the keystore with, e.g.:
#   keytool -genkeypair -v -keystore keystore/safeme-release.jks -alias safeme \
#     -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=SafeMe, O=SafeMe, C=BD"
# Losing this keystore or its passwords means the app can never be updated in place — back it up securely.
storeFile=keystore/safeme-release.jks
storePassword=
keyAlias=safeme
keyPassword=
